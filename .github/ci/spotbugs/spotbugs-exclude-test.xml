<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs exclude filter for the JUnit build's test tree.

    Kept separate from spotbugs-exclude.xml so the app source stays strict:
    nothing here can loosen the application's own analysis. Every entry is a
    JUnit idiom that SpotBugs reports because it assumes production code — none
    of them describe a defect in a test.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!--
        Tests implement contracts as anonymous classes to stub a single method
        inline. Hoisting each to a static nested class would scatter the stub
        away from the assertion that explains it, for no behavioral gain.
    -->
    <Match>
        <Bug pattern="SIC_INNER_SHOULD_BE_STATIC_ANON" />
    </Match>

    <!--
        Classes with only static members are instantiated deliberately, to cover
        their private constructors and hold branch coverage at 100%.
    -->
    <Match>
        <Bug pattern="ISC_INSTANTIATE_STATIC_CLASS" />
    </Match>

    <!--
        `void test() throws Exception` is the universal JUnit signature: the
        framework catches whatever a test throws and reports it as a failure, so
        narrowing every clause would add noise without adding safety.
    -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    </Match>

    <!--
        Valkyrja's throwables are all unchecked, so a test that documents what a
        method throws necessarily names a RuntimeException subclass.
    -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
    </Match>

    <!--
        Carried over from spotbugs-exclude.xml, which excludes this app-wide:
        mutable collections are stored and returned by design, and defensive
        copies in a test double would stop it mirroring the type it stands in for.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>

    <!--
        `var ignored = call();` invokes a method for its side effect while
        satisfying Error Prone's ReturnValueIgnored. The two tools disagree here;
        Error Prone wins, because dropping the assignment would drop the call.
    -->
    <Match>
        <Bug pattern="DLS_DEAD_LOCAL_STORE" />
    </Match>

</FindBugsFilter>
